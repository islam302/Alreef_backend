# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development
SITE_NAME=Alreef
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
# NOTE: inside docker-compose, DB_HOST=postgres and the internal port is
# always 5432. If you run Django locally (outside Docker) against the
# Dockerized Postgres, the container publishes to host port 5433 (see
# docker-compose.yml) to avoid clashing with a native Postgres install —
# use DB_PORT=5433 in that case.
DB_NAME=alreef
DB_USER=alreef
DB_PASSWORD=alreef
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Alreef <no-reply@alreef.example>

# SMS provider abstraction (console | vonage | twilio | msegat)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=ALREEF

# WhatsApp Cloud API (console | meta_cloud_api)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Egyptian payment providers ---------------------------------------------
# Paymob (https://paymob.com) — requires a verified merchant account
PAYMOB_ENABLED=False
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Fawry (https://developer.fawrystaging.com) — requires merchant onboarding
FAWRY_ENABLED=False
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# valU BNPL — requires merchant credentials
VALU_ENABLED=False
VALU_API_KEY=
VALU_BASE_URL=

# Cash on delivery
COD_ENABLED=True
COD_FEE_AMOUNT=15.00
COD_MIN_ORDER_AMOUNT=0.00
COD_MAX_ORDER_AMOUNT=50000.00

# --- Shipping providers ------------------------------------------------------
BOSTA_ENABLED=False
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co/api/v2

ARAMEX_ENABLED=False
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=

# Storage (S3-compatible, optional — leave USE_S3=False for local disk)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_CUSTOM_DOMAIN=

# Production security (config/settings/production.py)
# SECURE_SSL_REDIRECT defaults to True — correct when a real TLS-terminating
# proxy/load balancer sits in front of this app and forwards X-Forwarded-Proto.
# The docker-compose.yml nginx service does NOT terminate TLS out of the box,
# so set this to False for local/staging docker-compose runs without HTTPS,
# or configure nginx for TLS termination and leave it True.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Misc
LOG_LEVEL=INFO
LOG_FORMAT=simple
IDEMPOTENCY_KEY_TTL_SECONDS=86400
ABANDONED_CART_HOURS=6

# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development
SITE_NAME=Alreef
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
# NOTE: inside docker-compose, DB_HOST=postgres and the internal port is
# always 5432. If you run Django locally (outside Docker) against the
# Dockerized Postgres, the container publishes to host port 5433 (see
# docker-compose.yml) to avoid clashing with a native Postgres install —
# use DB_PORT=5433 in that case.
DB_NAME=alreef
DB_USER=alreef
DB_PASSWORD=alreef
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# The console backend above is fine for development. Production refuses to boot
# on it, because it delivers nothing and writes reset links to the log. Set this
# True only for a stack that deliberately sends no mail (CI, smoke tests).
ALLOW_UNSENDABLE_EMAIL_BACKEND=False
DEFAULT_FROM_EMAIL=Alreef <no-reply@alreef.example>

# SMS provider abstraction (console | vonage | twilio | msegat)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=ALREEF

# WhatsApp Cloud API (console | meta_cloud_api)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Storefront chat assistant ----------------------------------------------
# The floating chat on the storefront is answered by the Zaychain RAG API through
# the backend (POST /api/v1/chat/), so the key never reaches the browser. It is a
# secret: set it here only, never in a VITE_ variable. Empty switches the chat
# off — the widget still opens and offers WhatsApp instead.
CHATBOT_API_KEY=
CHATBOT_API_URL=https://chatbot-api.zaychain.com/api/v1/chat/
CHATBOT_TIMEOUT_SECONDS=30

# --- Egyptian payment providers ---------------------------------------------
# Every external gateway is off by default, and setting its ENABLED flag is NOT
# enough: the method stays hidden until all of its mandatory credentials are
# filled in too. Run `python manage.py check_payments` to see, per method,
# whether it is live and exactly which setting is empty if it is not.
#
# Webhook URLs to register in each provider's dashboard are printed by that same
# command. They are built from BACKEND_PUBLIC_URL, so set it before you register
# anything or you will register a localhost URL.
#
# Full setup checklist, per provider: docs/payments/PROVIDERS.md

# This API's own public origin. Payment providers call our webhooks out of band,
# so this cannot be derived from a request.
BACKEND_PUBLIC_URL=http://localhost:8000

# Paymob (https://accept.paymob.com)
#
# ONE GATEWAY, THREE METHODS. Card and mobile wallet today; InstaPay too, once
# Paymob releases it (they list it as coming soon). Set the matching
# PAYMOB_INTEGRATION_ID_* and that method appears at checkout.
#
# Credentials live in Paymob Dashboard -> Settings -> Account Info. Note that
# SECRET_KEY and API_KEY are DIFFERENT credentials: the first authenticates the
# Intention API (creating payments), the second the older Accept API (refunds,
# voids and status inquiries). Without API_KEY the shop can take money and not
# refund it, which the dashboard will tell you.
PAYMOB_ENABLED=False
# False = Paymob test keys. Recorded on every payment either way, so a live
# transaction created with a test key is visible rather than merely wrong.
PAYMOB_LIVE=False
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_API_KEY=
# Verifies every callback HMAC. Mandatory: without it we could take money and
# have no trustworthy way to learn that we had.
PAYMOB_HMAC_SECRET=
# Visa / Mastercard / Meeza.
PAYMOB_INTEGRATION_ID_CARD=
# Vodafone Cash, Etisalat, Orange, WE.
PAYMOB_INTEGRATION_ID_WALLET=
# Leave empty until InstaPay is live on your Paymob account. While it is empty,
# InstaPay is served by the manual-transfer route below; setting it switches the
# route automatically with no code change.
PAYMOB_INTEGRATION_ID_INSTAPAY=
# Only needed for the legacy iframe display mode.
PAYMOB_IFRAME_ID=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_TIMEOUT_SECONDS=20
# Register in Paymob -> Settings -> Payment Integrations -> Transaction
# Processed Callback:  https://<your-domain>/api/v1/payments/webhooks/paymob/

# InstaPay, as a bank transfer the customer makes and staff confirm.
#
# There is no API here and there is no API to have: InstaPay is the Central Bank
# of Egypt's instant transfer network, not a payment gateway, and it publishes no
# merchant acceptance API. This is how Egyptian shops are paid by InstaPay today —
# publish an address, take the transfer, confirm it. See docs/payments/instapay.md.
#
# IMPORTANT: an InstaPay order is NOT confirmed, and its stock is NOT consumed,
# until somebody posts the confirmation. Do not ship before that.
INSTAPAY_ENABLED=False
# The shop's InstaPay address (IPA), e.g. alreef@instapay. Shown to customers —
# it is a published payment address, not a credential. Mandatory when enabled.
INSTAPAY_ADDRESS=
# The account name the customer sees in their banking app, so a cautious customer
# can check it matches before transferring.
INSTAPAY_ACCOUNT_NAME=
# How long an order waits for the transfer before staff should chase it.
INSTAPAY_CONFIRM_WINDOW_HOURS=24

# Cash on delivery. No external API: the courier collects and staff record it.
# The payment stays `pending` from checkout until somebody records collection;
# moving an order to DELIVERED does that automatically.
COD_ENABLED=True
COD_FEE_AMOUNT=15.00
COD_MIN_ORDER_AMOUNT=0.00
# 0 means no ceiling.
COD_MAX_ORDER_AMOUNT=50000.00
# Comma-separated ShippingMethod ids. Empty means any — set it when a carrier
# that will not handle cash is added.
COD_ALLOWED_SHIPPING_METHOD_IDS=

# --- Payment safety rails ----------------------------------------------------
# Currencies the payment layer accepts. Anything else is rejected before a
# provider is contacted, because gateway integration IDs are currency-specific
# and a mismatch charges the wrong amount successfully.
PAYMENT_ALLOWED_CURRENCIES=EGP
# How stale a webhook may be before it is recorded but not applied. Providers
# retry for hours; an event about a payment we have moved on from must not be
# replayed onto it.
PAYMENT_WEBHOOK_MAX_AGE_HOURS=72

# --- Shipping providers ------------------------------------------------------
BOSTA_ENABLED=False
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co/api/v2

ARAMEX_ENABLED=False
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=

# Storage (S3-compatible, optional — leave USE_S3=False for local disk)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_CUSTOM_DOMAIN=

# Production security (config/settings/production.py)
# SECURE_SSL_REDIRECT defaults to True — correct when a real TLS-terminating
# proxy/load balancer sits in front of this app and forwards X-Forwarded-Proto.
# The docker-compose.yml nginx service does NOT terminate TLS out of the box,
# so set this to False for local/staging docker-compose runs without HTTPS,
# or configure nginx for TLS termination and leave it True.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Misc
LOG_LEVEL=INFO
LOG_FORMAT=simple
IDEMPOTENCY_KEY_TTL_SECONDS=86400
ABANDONED_CART_HOURS=6

# Most units of one variant allowed on a single cart line.
MAX_CART_ITEM_QUANTITY=100
